# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# SQLite Database Files & WAL files (do not commit sensitive assessment records)
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm
*.sqlite
*.sqlite3
!database/.gitkeep

# Evidence & Confidential Assessment Data
evidence/*
!evidence/.gitkeep

# Generated Reports
reports/*
!reports/.gitkeep

# Logs
logs/
*.log
zyron.log

# Environment variables & secrets
.env
.env.local
*.secret
*.pem
*.key

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE / Editor configuration
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini
